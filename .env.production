# Leave empty when production serves the frontend and API from the same origin/reverse proxy.
# Example: VITE_API_URL=https://api.example.com
VITE_API_URL=
# Public Mapbox token for production map/satellite layers. Restrict by domain in Mapbox.
# VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...
# Stripe publishable key used by Checkout in production (live key).
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
