# Public base URL of the backend.
# Leave empty in production when frontend and API share the same origin via reverse proxy.
# Example with separate API host: VITE_API_URL=https://api.example.com
VITE_API_URL=http://localhost:3000

# Public Mapbox token for map/satellite layers. Restrict by domain in Mapbox.
# VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# Public Stripe publishable key. Never use STRIPE_SECRET_KEY in frontend envs.
# Restrict live keys by domain/environment in Stripe when available.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
