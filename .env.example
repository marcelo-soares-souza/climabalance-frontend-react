# Public base URL of the backend. It should match the backend APP_URL/CORS policy so auth cookies work correctly.
# Leave empty when the frontend and API share the same origin via reverse proxy.
VITE_API_URL=http://localhost:3000

# Optional: Mapbox access token for satellite layer. Get one at https://account.mapbox.com/access-tokens/
# VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_5
